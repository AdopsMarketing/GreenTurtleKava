---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';

const entry = await getEntry('pages', 'turtle-tribe');
if (!entry) throw new Error('Missing turtle-tribe content entry');

const team = [
  {
    name: 'Candace',
    image: '/images/uploads/2021/07/Depositphotos_7930076_l-2015.jpg',
    bio: 'Candace, owner operator in Daytona Beach, previously battling sharks in the field of law for the past 10 years, decided to swim into calmer waters. A true passion for the kava culture, she makes for a great tribe leader Daytona.',
  },
  {
    name: 'Seth',
    image: '/images/uploads/2021/07/sea-turtle-547163_1280.jpg',
    bio: 'Seth, heading up R & D, will surely leverage ALL the exotic fine herbs. Having served in the restaurant and farming industries, he will be guiding the Green Turtle tribespeople to flavor town.',
  },
  {
    name: 'Mike',
    image: '/images/uploads/2021/07/green-sea-turtle-79945_1280.jpg',
    bio: 'Mike, full of creative marketing zest, has helped numerous local businesses get their message out. He supports efforts from afar, vigorously spreading the Green Turtle Kava Tribe word.',
  },
  {
    name: 'Holly',
    image: '/images/uploads/2021/07/sea-turtle-547162_1280.jpg',
    bio: 'Holly, supporter and turtle ambassador. Here to promote conservation efforts from Juno Beach. The oceanic bula vibe is strong with this one!',
  },
];
---

<Layout
  title={`${entry.data.title} | Green Turtle Kava Bar`}
  description={entry.data.metaDescription}
  canonical={entry.data.canonical}
  heroHeading="TURTLE TRIBE"
>
  <section class="bg-cover bg-no-repeat py-16" style="background-image: url('/images/theme/big-bg.png')">
    <Container>
      <div class="max-w-[900px] mx-auto bg-navy p-5">
        <div class="border border-white p-6 lg:p-10 grid lg:grid-cols-2 gap-8 items-center">
          <img
            src="/images/uploads/2021/05/turtle.png"
            alt="Green Turtle"
            width="334"
            height="424"
            class="w-full max-w-[280px] mx-auto h-auto"
          />
          <div>
            <h2 class="font-body text-gold text-[40px] lg:text-[60px]">who we are</h2>
            <div class="font-nav-book text-white text-[16px] lg:text-[17px] space-y-4 mt-4">
              <p>
                The Green Turtle is a place that promotes the idea of community. Where like minded
                people can come together and feel a sense of belonging. We strive to create a
                welcoming atmosphere, where a person can feel accepted.
              </p>
              <p>
                Green turtles represent peace, longevity and wisdom. We try to incorporate these
                ideas into our mantra, working to make the Green Turtle a place where a person can
                slow down and take a moment. Here, we believe that it is this reflection that helps
                to foster balance within one&rsquo;s life.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid lg:grid-cols-2 gap-10 mt-14 items-center max-w-[1140px] mx-auto">
        <div>
          <h2 class="font-body text-gold text-[32px]">Your Green Turtle Team Members</h2>
          <h1 class="font-body text-brown text-[33px] lg:text-[76px] leading-tight mt-2">
            KAVA SHARED<br />WITH A FRIEND<br />IS HAPPINESS &ndash; BULA!
          </h1>
          <p class="font-nav-book text-muted-blue text-[18px] mt-4">
            Stop in on your way through &ndash; have a shell for shells&hellip;
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <img src="/images/uploads/2021/07/Depositphotos_27155705_l-2015.jpg" alt="green turtle kava bar turtle" width="400" height="300" class="w-full h-full object-cover" />
          <img src="/images/uploads/2021/07/sea-turtle-547163_1280.jpg" alt="green turtle kava team turtle" width="400" height="300" class="w-full h-full object-cover" />
          <img src="/images/uploads/2021/07/sea-turtle-547162_1280.jpg" alt="green turtle kava team turtle" width="400" height="300" class="w-full h-full object-cover" />
          <img src="/images/uploads/2021/07/Depositphotos_27155705_l-2015.jpg" alt="green turtle kava bar turtle" width="400" height="300" class="w-full h-full object-cover" />
          <img src="/images/uploads/2021/07/Depositphotos_43499039_l-2015.jpg" alt="green turtle kava bar turtle" width="400" height="300" class="w-full h-full object-cover" />
          <img src="/images/uploads/2021/07/Depositphotos_7930076_l-2015.jpg" alt="green turtle kava bar turtle" width="400" height="300" class="w-full h-full object-cover" />
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-cover bg-no-repeat py-16" style="background-image: url('/images/theme/s-bg.png')">
    <Container>
      <h1 class="font-body text-brown text-[30px] lg:text-[70px] text-center flex items-center justify-center gap-4">
        <img src="/images/theme/line.png" alt="" class="w-[225px] hidden md:block" />
        <span>Team Members</span>
        <img src="/images/theme/line.png" alt="" class="w-[225px] hidden md:block" />
      </h1>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mt-10 max-w-[1140px] mx-auto">
        {team.map((member) => (
          <div class="group border border-black bg-white overflow-hidden transition-all duration-500">
            <div class="relative h-[200px] overflow-hidden">
              <img
                src="/images/logo.png"
                alt="Green Turtle Kava"
                width="200"
                height="200"
                class="w-full h-[200px] object-contain p-4"
              />
              <div class="absolute inset-0 opacity-0 scale-[2.2] transition-all duration-500 group-hover:opacity-100 group-hover:scale-100">
                <img src={member.image} alt={member.name} width="400" height="200" class="w-full h-[200px] object-cover" />
              </div>
            </div>
            <div class="px-2.5 py-2 text-center">
              <h4 class="text-heading-blue text-[20px] font-nav-book font-semibold">{member.name}</h4>
              <p class="font-nav-book text-muted-gray text-sm mt-1">{member.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="bg-cover bg-no-repeat py-16" style="background-image: url('/images/theme/s-bg.png')">
    <Container>
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div>
          <h2 class="font-script text-gold text-[70px]"><a href="/">Green Turtle Kava</a></h2>
          <h1 class="font-body text-brown text-[30px] lg:text-[95px] leading-none mt-2">
            KAVA SHARED<br />WITH A FRIEND<br />IS COMMUNITY
          </h1>
        </div>
        <div class="relative">
          <img src="/images/uploads/2021/05/hot.png" alt="Kava Bar in Saint Augustine, FL" width="503" height="813" class="w-full h-auto" />
          <div class="lg:absolute lg:top-[15%] lg:left-[8%] bg-black/90 p-6 lg:p-8 max-w-[400px] mt-4 lg:mt-0">
            <h3 class="text-gold text-[40px] font-body">RESET AND RELAX</h3>
            <p class="text-white font-nav-book text-[19px] lg:text-[23px] mt-2">
              Kava and Tea to bring you together for good conversation with good people.<br />
              Your local oasis to unwind, connect with friends and reset during the day.
            </p>
            <div class="flex justify-end mt-4">
              <Button href="/about-us/" variant="click">CLICK HERE</Button>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>
</Layout>

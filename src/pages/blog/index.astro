---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout
  title="Blog | Green Turtle Kava Bar"
  description="Kava news, guides, and stories from Green Turtle Kava Bar — St. Augustine, Daytona Beach, and Ormond Beach."
  canonical="https://greenturtlekava.co/blog/"
  heroHeading="OUR BLOG"
>
  <Section variant="cream">
    <Container>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => {
          const date = new Date(post.data.date).toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          });
          return (
            <a href={`/${post.data.slug}/`} class="block bg-white border border-brown/10">
              {post.data.ogImage && (
                <img src={post.data.ogImage} alt={post.data.title} class="w-full h-[200px] object-cover" width="400" height="200" loading="lazy" />
              )}
              <div class="p-5">
                <p class="font-nav-book text-muted-gray text-sm">{date}</p>
                <h3 class="font-body text-brown text-[22px] leading-tight mt-1">{post.data.title}</h3>
              </div>
            </a>
          );
        })}
      </div>
    </Container>
  </Section>
</Layout>

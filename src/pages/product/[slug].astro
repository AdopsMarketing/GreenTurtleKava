---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import { products, priceRange } from '../../data/products';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const optionValues = product.variants.map((v) => v.label).join(', ');
---

<Layout
  title={`${product.name} | Green Turtle Kava Bar`}
  description={product.description}
  canonical={`https://greenturtlekava.co/product/${product.slug}/`}
  ogImage={product.image}
  heroHeading="SHOP"
>
  <section class="bg-cream py-16">
    <Container>
      <a href="/shop/" class="inline-block font-nav-book text-link hover:text-link-hover text-[16px] mb-8">&larr; Back to shop</a>

      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start max-w-[1050px] mx-auto">
        <div class="bg-white">
          <img src={product.image} alt={product.name} width="600" height="600" class="w-full aspect-square object-contain" />
        </div>

        <div data-product={product.slug}>
          <h1 class="font-body text-body-text text-[32px] lg:text-[56px] leading-tight">{product.name}</h1>
          <p class="font-nav text-[#958e09] text-[28px] lg:text-[36px] mt-3" data-price>{priceRange(product)}</p>

          {product.color && (
            <p class="font-nav-book text-muted-gray text-[16px] mt-2">Color: {product.color}</p>
          )}
          <p class="font-nav-book text-muted-blue text-[17px] mt-4 max-w-[480px]">{product.description}</p>

          <div class="mt-8 space-y-5 max-w-[380px]">
            <label class="block">
              <span class="block font-nav text-brown text-[17px] mb-1">{product.optionName}</span>
              <select
                data-variant
                class="w-full bg-white border border-brown rounded-none py-2 px-3 font-nav-book text-body-text focus:outline-none focus:border-gold"
              >
                <option value="">Choose an option</option>
                {product.variants.map((v) => (
                  <option value={v.id}>{v.label}</option>
                ))}
              </select>
            </label>

            <div class="flex items-end gap-3">
              <label class="block">
                <span class="block font-nav text-brown text-[17px] mb-1">Quantity</span>
                <input
                  data-qty
                  type="number"
                  min="1"
                  max="99"
                  value="1"
                  class="w-24 bg-white border border-brown rounded-none py-2 px-3 font-nav-book text-body-text focus:outline-none focus:border-gold"
                />
              </label>
              <button
                data-add
                type="button"
                disabled
                class="border-2 border-navy text-navy font-nav text-[19px] px-7 py-2 rounded-none transition-colors hover:bg-navy hover:text-white disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-navy"
              >
                Add to cart
              </button>
            </div>

            <p data-added class="hidden font-nav-book text-[16px] text-green-700">
              Added to cart. <a href="/cart/" class="underline text-link hover:text-link-hover">View cart &rarr;</a>
            </p>
          </div>
        </div>
      </div>

      <div class="max-w-[1050px] mx-auto mt-16 border-t border-brown/20 pt-8">
        <h2 class="font-body text-brown text-[26px] mb-3">Additional information</h2>
        <table class="w-full max-w-[500px] font-nav-book text-body-text text-[16px]">
          <tbody>
            <tr class="border-b border-brown/15">
              <th class="text-left font-semibold py-2 pr-6 align-top">{product.optionName}</th>
              <td class="py-2">{optionValues}</td>
            </tr>
            {product.color && (
              <tr class="border-b border-brown/15">
                <th class="text-left font-semibold py-2 pr-6 align-top">Color</th>
                <td class="py-2">{product.color}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </Container>
  </section>
</Layout>

<script>
  import { addItem } from '../../scripts/cart';
  import { productBySlug, priceRange, formatUsd } from '../../data/products';

  const root = document.querySelector<HTMLElement>('[data-product]');
  if (root) {
    const product = productBySlug(root.dataset.product!)!;
    const select = root.querySelector<HTMLSelectElement>('[data-variant]')!;
    const qty = root.querySelector<HTMLInputElement>('[data-qty]')!;
    const priceEl = root.querySelector<HTMLElement>('[data-price]')!;
    const addBtn = root.querySelector<HTMLButtonElement>('[data-add]')!;
    const added = root.querySelector<HTMLElement>('[data-added]')!;

    select.addEventListener('change', () => {
      const variant = product.variants.find((v) => v.id === select.value);
      priceEl.textContent = variant ? formatUsd(variant.price) : priceRange(product);
      addBtn.disabled = !variant;
      added.classList.add('hidden');
    });

    addBtn.addEventListener('click', () => {
      if (!select.value) return;
      const n = Math.max(1, Math.min(99, parseInt(qty.value, 10) || 1));
      addItem(select.value, n);
      added.classList.remove('hidden');
    });
  }
</script>

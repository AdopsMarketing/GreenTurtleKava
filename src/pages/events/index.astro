---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import FormInput from '../../components/FormInput.astro';
import Button from '../../components/Button.astro';
import EventCard from '../../components/EventCard.astro';
import EventCountdown from '../../components/EventCountdown.astro';

const allEvents = await getCollection('events');

function detectLocation(body: string): 'St. Augustine' | 'Daytona Beach' | 'Ormond Beach' | 'Other' {
  if (/Daytona Beach/i.test(body)) return 'Daytona Beach';
  if (/Ormond Beach/i.test(body)) return 'Ormond Beach';
  if (/St\.?\s?Augustine/i.test(body)) return 'St. Augustine';
  return 'Other';
}

const MONTHS = ['january','february','march','april','may','june','july','august','september','october','november','december'];

// Many event slugs encode the real event date (e.g. "massage-and-dry-needling-july-25"),
// which is far more reliable than the WP post-creation date for picking the next upcoming event.
function eventDate(slug: string, fallbackIso: string): Date {
  const match = slug.match(/-([a-z]+)-(\d{1,2})$/i);
  if (match) {
    const monthIndex = MONTHS.indexOf(match[1].toLowerCase());
    const day = parseInt(match[2], 10);
    if (monthIndex >= 0 && day >= 1 && day <= 31) {
      const fallback = new Date(fallbackIso);
      let year = fallback.getFullYear();
      let candidate = new Date(year, monthIndex, day, 12, 0, 0);
      return candidate;
    }
  }
  return new Date(fallbackIso);
}

const now = new Date();
const withLocation = allEvents.map((e) => ({
  event: e,
  location: detectLocation(e.body ?? ''),
  parsedDate: eventDate(e.data.slug, e.data.date as unknown as string),
}));
withLocation.sort((a, b) => b.parsedDate.getTime() - a.parsedDate.getTime());

const upcoming = withLocation.filter((x) => x.parsedDate.getTime() >= now.getTime()).sort((a, b) => a.parsedDate.getTime() - b.parsedDate.getTime());
const nextItem = upcoming[0] ?? withLocation[0];
const nextEvent = nextItem?.event;
const nextEventDate = nextItem?.parsedDate;

const groups: Record<string, typeof withLocation> = {
  'St. Augustine': [],
  'Daytona Beach': [],
  'Ormond Beach': [],
  'Other': [],
};
for (const item of withLocation) {
  groups[item.location].push(item);
}

const groupOrder = ['St. Augustine', 'Daytona Beach', 'Ormond Beach', 'Other'] as const;
const groupLabels: Record<string, string> = {
  'St. Augustine': 'St Augustine Events',
  'Daytona Beach': 'Daytona Beach Events',
  'Ormond Beach': 'Ormond Beach Events',
  'Other': 'Coming Soon Events',
};
---

<Layout
  title="Events | Green Turtle Kava Bar"
  description="Live music, trivia, bingo, and more — see what's happening at Green Turtle Kava Bar's St. Augustine, Daytona Beach, and Ormond Beach locations."
  canonical="https://greenturtlekava.co/events/"
  heroHeading="EVENTS"
>
  {nextEvent && nextEventDate && (
    <EventCountdown
      targetIso={nextEventDate.toISOString()}
      title={nextEvent.data.title}
      href={`/event/${nextEvent.data.slug}/`}
      image={nextEvent.data.ogImage}
    />
  )}

  <section class="bg-cover bg-no-repeat py-16" style="background-image: url('/images/theme/obg.png')">
    <Container>
      {groupOrder.map((key) => groups[key].length > 0 && (
        <div class="mb-16">
          <h1 class="font-body text-brown text-[40px] mb-6">{groupLabels[key]}</h1>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
            {groups[key].slice(0, 3).map(({ event }) => (
              <EventCard event={event} />
            ))}
          </div>
        </div>
      ))}
    </Container>
  </section>

  <section class="bg-cover bg-no-repeat py-24 lg:py-32" style="background-image: url('/images/theme/b-bg.png')">
    <Container>
      <div class="max-w-150 mx-auto text-center">
        <h1 class="font-body text-white text-[30px] lg:text-[80px] mb-4">Join The Turtle Tribe</h1>
        <p class="font-nav-book text-white mb-8">
          Sign up free with the link below for updates on upcoming events, promos and rewards for turtle tribe members
        </p>
        <form class="space-y-6 text-left">
          <FormInput name="first_name" label="First Name" required class="[&_input]:text-white border-tan border-2 rounded-xs" />
          <FormInput name="email" type="email" label="Email" required class="[&_input]:text-white border-tan border-2 rounded-xs" />
          <FormInput name="phone" type="tel" label="Phone Number" class="[&_input]:text-white border-tan border-2 rounded-xs" />
          <div class="text-center pt-2">
            <Button type="submit" variant="sign">Submit</Button>
          </div>
        </form>
      </div>
    </Container>
  </section>
</Layout>

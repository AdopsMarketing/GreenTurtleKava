---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Heading from '../components/Heading.astro';
import Button from '../components/Button.astro';

const entry = await getEntry('pages', 'kava-shop');
if (!entry) throw new Error('Missing kava-shop content entry');
---

<Layout
  title={`${entry.data.title} | Green Turtle Kava Bar`}
  description={entry.data.metaDescription}
  canonical={entry.data.canonical}
  heroHeading="SHOP"
>
  <Section variant="cream">
    <Container>
      <div class="text-center max-w-[600px] mx-auto">
        <Heading level="h2" class="!text-[45px]">Shop</Heading>
        <p class="font-nav-book text-muted-gray mt-4">
          Browse our full lineup of kava, botanical teas, and merchandise in the online shop.
        </p>
        <div class="mt-8">
          <Button href="/shop/" variant="customer">Visit the Shop</Button>
        </div>
      </div>
    </Container>
  </Section>
</Layout>

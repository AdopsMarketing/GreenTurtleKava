---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import LeadFormsScript from '../components/LeadFormsScript.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  heroHeading?: string;
}

const { title, description = '', canonical, ogImage = '', heroHeading } = Astro.props;
const resolvedCanonical = canonical ?? Astro.url.href;

// OptiMonk — popups/campaigns (spin-to-win etc.) are managed in the OptiMonk dashboard.
// Account ID from OptiMonk → Install code; override per-environment with PUBLIC_OPTIMONK_ACCOUNT_ID.
const OPTIMONK_ACCOUNT_ID = import.meta.env.PUBLIC_OPTIMONK_ACCOUNT_ID ?? '195346';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={resolvedCanonical} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/fontsfree-net-theforegenroughone-webfont.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/futura-pt-medium.woff2" as="font" type="font/woff2" crossorigin />

    {OPTIMONK_ACCOUNT_ID && (
      <script
        is:inline
        async
        type="text/javascript"
        src={`https://front.optimonk.com/public/${OPTIMONK_ACCOUNT_ID}/js/preload.js`}
      ></script>
    )}
  </head>
  <body class="font-body text-body-text bg-cream">
    <Header />
    {heroHeading && <HeroSection heading={heroHeading} />}
    <main>
      <slot />
    </main>
    <Footer />
    <LeadFormsScript />
  </body>
</html>

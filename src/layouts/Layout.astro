---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import LeadFormsScript from '../components/LeadFormsScript.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  heroHeading?: string;
  noindex?: boolean;
}

const { title, description = '', canonical, ogImage = '', heroHeading, noindex = false } = Astro.props;
const resolvedCanonical = canonical ?? Astro.url.href;

// OptiMonk — popups/campaigns (spin-to-win etc.) are managed in the OptiMonk dashboard.
// Account ID from OptiMonk → Install code; override per-environment with PUBLIC_OPTIMONK_ACCOUNT_ID.
const OPTIMONK_ACCOUNT_ID = import.meta.env.PUBLIC_OPTIMONK_ACCOUNT_ID ?? '195346';

// Google Tag Manager — GA4, Google Ads conversions, etc. are managed inside the GTM container.
const GTM_ID = import.meta.env.PUBLIC_GTM_ID ?? 'GTM-PTTRCX2';

// Google Analytics 4 (gtag.js), loaded directly. Override with PUBLIC_GA4_ID.
const GA4_ID = import.meta.env.PUBLIC_GA4_ID ?? 'G-EJSD6Z7EW5';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {GTM_ID && (
      <script is:inline define:vars={{ gtmId: GTM_ID }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
      </script>
    )}

    {GA4_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
        <script is:inline define:vars={{ ga4Id: GA4_ID }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ window.dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </>
    )}
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={resolvedCanonical} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/fontsfree-net-theforegenroughone-webfont.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/futura-pt-medium.woff2" as="font" type="font/woff2" crossorigin />

    {OPTIMONK_ACCOUNT_ID && (
      <script
        is:inline
        async
        type="text/javascript"
        src={`https://front.optimonk.com/public/${OPTIMONK_ACCOUNT_ID}/js/preload.js`}
      ></script>
    )}
  </head>
  <body class="font-body text-body-text bg-cream">
    {GTM_ID && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="gtm"></iframe>
      </noscript>
    )}
    <Header />
    {heroHeading && <HeroSection heading={heroHeading} />}
    <main>
      <slot />
    </main>
    <Footer />
    <LeadFormsScript />
  </body>
</html>

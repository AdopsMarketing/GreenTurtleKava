---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import SpinPopup from '../components/SpinPopup.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  heroHeading?: string;
}

const { title, description = '', canonical, ogImage = '', heroHeading } = Astro.props;
const resolvedCanonical = canonical ?? Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={resolvedCanonical} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/fontsfree-net-theforegenroughone-webfont.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/futura-pt-medium.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="font-body text-body-text bg-cream">
    <Header />
    {heroHeading && <HeroSection heading={heroHeading} />}
    <main>
      <slot />
    </main>
    <Footer />
    <!-- <SpinPopup /> -->
  </body>
</html>

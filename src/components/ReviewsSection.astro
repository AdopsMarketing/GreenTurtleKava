---
// "What your TURTLE TRIBE IS SAYING...." reviews block (Google / Yelp / Facebook).
// Used on the homepage, about-us, and each location page.
//   - showButton: render the "25% OFF NEW CUSTOMER" CTA below the logos (homepage).
//   - bare:       render only the inner block, without the <section>/background/Container
//                 wrapper — for embedding inside an existing section (location pages).
import Container from './Container.astro';
import Button from './Button.astro';

interface Props {
  showButton?: boolean;
  bare?: boolean;
  class?: string;
}
const { showButton = false, bare = false, class: className = '' } = Astro.props;

const reviews = [
  { href: 'https://g.page/r/CaEOOAOqSzSDEAE?gm', src: '/images/media/2021/05/b1.png', alt: 'Google Reviews', width: 'max-w-[222px]' },
  { href: 'https://www.yelp.com/biz/green-turtle-kava-bar-st-augustine-st-augustine', src: '/images/media/2021/05/b2.png', alt: 'Yelp Reviews', width: 'max-w-[262px]' },
  { href: 'https://www.facebook.com/greenturtlekavabar', src: '/images/media/2021/05/b3.png', alt: 'Facebook Reviews', width: 'max-w-[280px]' },
];
const cloverUrl = 'https://customers.clover.com/start/?merchantUuid=6ef61bb4-a8be-4038-8ce1-5be968f77b1a&t=1631902268082';
---

{bare ? (
  <div class:list={['text-center', className]}>
    <h2 class="font-script text-tan-light text-[45px] lg:text-[70px] leading-none">
      What your
      <img src="/images/theme/line.png" alt="" class="mx-auto mt-1 w-[177px]" />
    </h2>
    <h1 class="font-body text-brown text-[30px] lg:text-[70px] mt-2">TURTLE TRIBE IS SAYING....</h1>
    <div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-6 max-w-[900px] mx-auto mt-10">
      {reviews.map((r) => (
        <a href={r.href} target="_blank" rel="noopener">
          <img src={r.src} alt={r.alt} class={`h-auto w-auto ${r.width}`} />
        </a>
      ))}
    </div>
    {showButton && (
      <div class="mt-8">
        <Button href={cloverUrl} variant="customer">25% OFF NEW CUSTOMER</Button>
      </div>
    )}
  </div>
) : (
  <section
    class:list={['bg-cover bg-no-repeat py-16 text-center', className]}
    style="background-image: url('/images/theme/obg.png')"
  >
    <Container>
      <h2 class="font-script text-tan-light text-[45px] lg:text-[70px] leading-none">
        What your
        <img src="/images/theme/line.png" alt="" class="mx-auto mt-1 w-[177px]" />
      </h2>
      <h1 class="font-body text-brown text-[30px] lg:text-[70px] mt-2">TURTLE TRIBE IS SAYING....</h1>
      <div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-6 max-w-[900px] mx-auto mt-10">
        {reviews.map((r) => (
          <a href={r.href} target="_blank" rel="noopener">
            <img src={r.src} alt={r.alt} class={`h-auto w-auto ${r.width}`} />
          </a>
        ))}
      </div>
      {showButton && (
        <div class="mt-8">
          <Button href={cloverUrl} variant="customer">25% OFF NEW CUSTOMER</Button>
        </div>
      )}
    </Container>
  </section>
)}

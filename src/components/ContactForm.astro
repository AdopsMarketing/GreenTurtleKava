---
// Replaces the original Contact Form 7 / Gravity Forms widget. Submits to Formspree —
// swap data-form-id below for the client's real Formspree (or serverless) endpoint before launch.
interface Props {
  submitLabel?: string;
  showMessage?: boolean;
  showSmsOptIn?: boolean;
}
import FormInput from './FormInput.astro';
import FormTextarea from './FormTextarea.astro';
import Button from './Button.astro';

const { submitLabel = 'Send Message', showMessage = true, showSmsOptIn = false } = Astro.props;
---

<form action="/api/lead" method="POST" data-lead data-lead-success="Thanks — we’ll be in touch soon." class="space-y-5 max-w-[600px] mx-auto">
  <input type="hidden" name="source" value="Contact form" />
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <FormInput name="name" label="Name" required />
  <FormInput name="email" type="email" label="Email" required />
  <FormInput name="phone" type="tel" label="Phone" />
  {showMessage && <FormTextarea name="message" label="Message" rows={5} />}
  {showSmsOptIn && (
    <label class="flex items-start gap-2 font-nav-book text-sm text-muted-gray">
      <input type="checkbox" name="sms_opt_in" required class="mt-1" />
      <span>
        Sign Up For SMS. You agree to receive automatic Transactional messages. Terms and
        Privacy Policy can be found at
        <a href="/privacy-policy/" class="text-link hover:text-link-hover underline">https://greenturtlekava.co/privacy-policy/</a>.
        You may receive up to 5 msgs/mo. Txt and data rates may apply. Reply STOP to end or HELP for help.
      </span>
    </label>
  )}
  <div class="text-center pt-2">
    <Button type="submit" variant="submit">{submitLabel}</Button>
    <p data-lead-status hidden class="text-body-text"></p>
  </div>
</form>

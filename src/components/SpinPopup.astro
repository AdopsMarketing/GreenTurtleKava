---
// Custom "spin-to-win" popup — a from-scratch replacement for the live site's
// OptinMonster lucky-wheel campaign, rebuilt to match the live wheel's exact
// geometry: 12 sectors, white labels reading inward from the rim (anchor=end,
// rotated 16 + 30*i degrees, per the live SVG), rim dots and a white hub.
// Front-end only: captures the email in localStorage and reveals a coupon.
// Wire `postEmail()` in the script below to a real endpoint when available.

// 12 wedges, in the live angular order (label 1..12), alternating win / try-again.
const WEDGES = [
  { label: 'BOGO ANY',      win: true,  code: 'BOGOANY',  prize: 'Buy One Get One — any drink' },
  { label: 'So close',      win: false },
  { label: '10% OFF',       win: true,  code: 'KAVA10',   prize: '10% off your order' },
  { label: 'No luck today', win: false },
  { label: 'BOGO 2X',       win: true,  code: 'BOGO2X',   prize: 'Buy One Get Two' },
  { label: 'Spin again',    win: false },
  { label: 'FRESHY',        win: true,  code: 'FRESHY',   prize: 'A free Freshy' },
  { label: 'Next time',     win: false },
  { label: '20% OFF',       win: true,  code: 'KAVA20',   prize: '20% off your order' },
  { label: 'Almost',        win: false },
  { label: 'BULA MULA',     win: true,  code: 'BULAMULA', prize: 'A free Bula Mula!' },
  { label: 'Not quite',     win: false },
];

// Geometry — 400x400 viewBox, matching the live wheel's proportions (730 box scaled).
const CX = 200, CY = 200;
const R = 180;   // colored sector radius
const RING = 192; // white rim radius
const SEG = 30;
const START = 16; // live: wedge/label 1 centered at 16deg clockwise from +x axis
const NAVY = '#2b4a5f';
const GOLD = '#c5a771';

const P = (deg: number, r: number): [number, number] => {
  const a = (deg * Math.PI) / 180; // 0 = +x (3 o'clock), positive = clockwise (y down)
  return [CX + r * Math.cos(a), CY + r * Math.sin(a)];
};

const wedges = WEDGES.map((w, i) => {
  const center = START + SEG * i;
  const a0 = center - SEG / 2;
  const a1 = center + SEG / 2;
  const [x0, y0] = P(a0, R);
  const [x1, y1] = P(a1, R);
  const path = `M ${CX} ${CY} L ${x0.toFixed(2)} ${y0.toFixed(2)} A ${R} ${R} 0 0 1 ${x1.toFixed(2)} ${y1.toFixed(2)} Z`;
  const fill = i % 2 === 0 ? NAVY : GOLD;
  const [dx, dy] = P(a1, RING - 5); // decorative rim dot at each boundary
  return { path, fill, center, dx, dy, label: w.label };
});
---

<div
  id="spin-popup"
  class="fixed inset-0 z-[9999] hidden items-center justify-center p-4"
  style="background-color: rgba(49,80,85,0.85)"
  role="dialog"
  aria-modal="true"
  aria-label="Spin the wheel to win a prize"
>
  <div class="relative w-full max-w-[860px] bg-cream shadow-2xl rounded-none">
    <button
      id="spin-close"
      class="absolute -top-3 -right-3 z-10 w-9 h-9 rounded-full bg-navy text-white text-lg leading-none flex items-center justify-center shadow-lg hover:bg-brown-dark transition-colors"
      aria-label="Close"
    >&times;</button>

    <div class="grid lg:grid-cols-2 gap-6 lg:gap-8 items-center p-6 lg:p-10">
      <!-- Wheel -->
      <div class="relative mx-auto w-full max-w-[340px]">
        <!-- pointer -->
        <div class="absolute left-1/2 -translate-x-1/2 -top-1 z-20"
             style="width:0;height:0;border-left:14px solid transparent;border-right:14px solid transparent;border-top:24px solid #614b34"></div>
        <svg id="spin-wheel" viewBox="0 0 400 400" class="w-full h-auto drop-shadow-xl">
          <circle cx="200" cy="200" r="192" fill="#ffffff" />
          <circle cx="200" cy="200" r="192" fill="none" stroke={GOLD} stroke-width="3" />
          <g id="spin-wheel-rot" style="transform-origin:200px 200px">
            {wedges.map((w) => (
              <path d={w.path} fill={w.fill} stroke="#ffffff" stroke-width="2" />
            ))}
            {wedges.map((w) => (
              <circle cx={w.dx} cy={w.dy} r="3.2" fill={GOLD} />
            ))}
            {wedges.map((w) => (
              <text
                x="359"
                y="200"
                fill="#ffffff"
                font-size="11.5"
                text-anchor="end"
                dominant-baseline="middle"
                transform={`rotate(${w.center} 200 200)`}
                style="font-family:'Futura PT Medium',Montserrat,sans-serif;letter-spacing:.02em;paint-order:stroke;stroke:rgba(0,0,0,.28);stroke-width:2px"
              >{w.label}</text>
            ))}
          </g>
          <!-- hub -->
          <circle cx="200" cy="200" r="33" fill="#ffffff" stroke={GOLD} stroke-width="4" />
          <text x="200" y="200" text-anchor="middle" dominant-baseline="central"
                fill={NAVY} font-size="15" font-weight="700"
                style="font-family:'the_foregen_rough_oneregular',sans-serif">SPIN</text>
        </svg>
      </div>

      <!-- Copy + form -->
      <div class="text-center lg:text-left">
        <h2 class="font-body text-navy text-[34px] lg:text-[44px] leading-none">SPIN THE WHEEL!</h2>
        <p class="font-nav-book text-body-text text-[16px] mt-3">
          Enter your email address to spin the wheel for a chance to win <strong>BULA MULA!</strong>
        </p>

        <form id="spin-form" class="mt-5 space-y-3" novalidate>
          <input
            id="spin-email"
            type="email"
            required
            placeholder="Your email address"
            class="w-full border-2 border-tan bg-white px-4 py-3 text-body-text text-[16px] rounded-none focus:border-navy focus:outline-none"
          />
          <button
            id="spin-btn"
            type="submit"
            class="w-full bg-navy text-white font-nav uppercase tracking-wide text-[18px] py-3 rounded-none hover:bg-brown-dark transition-colors disabled:opacity-60"
          >Spin to Win</button>
          <p id="spin-error" class="hidden text-alert-red text-[13px] font-nav-book text-left">Please enter a valid email.</p>
        </form>

        <!-- Result -->
        <div id="spin-result" class="hidden mt-5 border-2 border-gold bg-white p-5">
          <p class="font-body text-navy text-[26px] leading-none" id="spin-result-title">You won!</p>
          <p class="font-nav-book text-body-text text-[15px] mt-2" id="spin-result-desc"></p>
          <div id="spin-code-wrap" class="mt-3">
            <span class="font-nav-book text-muted-blue text-[13px] block">Your code</span>
            <div class="flex items-stretch gap-2 mt-1 justify-center lg:justify-start">
              <code id="spin-code" class="font-nav text-navy text-[22px] tracking-widest border-2 border-dashed border-navy px-3 py-1 bg-cream"></code>
              <button id="spin-copy" type="button" class="bg-gold text-navy font-nav text-[13px] px-3 rounded-none hover:bg-navy hover:text-white transition-colors">COPY</button>
            </div>
          </div>
          <a href="/shop/" class="inline-block mt-4 font-nav uppercase text-[14px] bg-navy text-white px-5 py-2 hover:bg-brown-dark transition-colors">Shop Now</a>
        </div>

        <p class="font-nav-book text-muted-gray text-[11px] mt-4">
          No purchase necessary. One spin per visitor.
          <button id="spin-nothanks" type="button" class="underline hover:text-navy">No thanks</button>
        </p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ WEDGES, SEG, START }}>
  (function () {
    const KEY = 'gtk_spin_v1';
    const popup = document.getElementById('spin-popup');
    if (!popup) return;
    const rot = document.getElementById('spin-wheel-rot');
    const form = document.getElementById('spin-form');
    const emailEl = document.getElementById('spin-email');
    const btn = document.getElementById('spin-btn');
    const errEl = document.getElementById('spin-error');
    const result = document.getElementById('spin-result');
    const rTitle = document.getElementById('spin-result-title');
    const rDesc = document.getElementById('spin-result-desc');
    const codeWrap = document.getElementById('spin-code-wrap');
    const codeEl = document.getElementById('spin-code');

    let state = {};
    try { state = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) {}

    function open() {
      popup.classList.remove('hidden');
      popup.classList.add('flex');
      document.documentElement.style.overflow = 'hidden';
    }
    function close() {
      popup.classList.add('hidden');
      popup.classList.remove('flex');
      document.documentElement.style.overflow = '';
    }
    function save() { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }

    if (!state.done) setTimeout(open, 1500);

    document.getElementById('spin-close').addEventListener('click', close);
    document.getElementById('spin-nothanks').addEventListener('click', function () { state.done = true; save(); close(); });
    popup.addEventListener('click', function (e) { if (e.target === popup) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });

    // Weighted outcome — always lands on a winning wedge.
    const OUTCOMES = [
      { i: 2, w: 40 },  // 10% off
      { i: 8, w: 22 },  // 20% off
      { i: 6, w: 13 },  // FRESHY
      { i: 0, w: 11 },  // BOGO ANY
      { i: 4, w: 9 },   // BOGO 2X
      { i: 10, w: 5 },  // BULA MULA
    ];
    function pick() {
      const total = OUTCOMES.reduce((s, o) => s + o.w, 0);
      let r = Math.random() * total;
      for (const o of OUTCOMES) { if ((r -= o.w) <= 0) return o.i; }
      return 2;
    }

    // Placeholder for real email capture — swap for a fetch() to your provider.
    function postEmail(email) {
      const emails = state.emails || [];
      emails.push(email);
      state.emails = emails;
      save();
    }

    let spinning = false;
    let currentRot = 0;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (spinning || state.done) return;
      const email = (emailEl.value || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { errEl.classList.remove('hidden'); return; }
      errEl.classList.add('hidden');
      postEmail(email);

      spinning = true;
      btn.disabled = true;
      btn.textContent = 'Spinning…';

      const idx = pick();
      // Wedge center (clockwise from +x) = START + 30*idx. Pointer sits at top (270deg).
      // Rotate so the wedge center lands under the pointer.
      const jitter = (Math.random() * 2 - 1) * (SEG * 0.30);
      const desired = (((270 - (START + SEG * idx) + jitter) % 360) + 360) % 360;
      const curMod = ((currentRot % 360) + 360) % 360;
      let advance = desired - curMod;
      if (advance < 0) advance += 360;
      currentRot += 360 * 5 + advance;

      rot.style.transition = 'transform 4.6s cubic-bezier(0.17,0.67,0.12,0.99)';
      rot.style.transform = 'rotate(' + currentRot + 'deg)';

      let settled = false;
      const onEnd = function () {
        if (settled) return;
        settled = true;
        rot.removeEventListener('transitionend', onEnd);
        const wedge = WEDGES[idx];
        state.done = true;
        state.result = wedge.label;
        save();
        form.classList.add('hidden');
        result.classList.remove('hidden');
        rTitle.textContent = 'You won ' + wedge.label + '!';
        rDesc.textContent = wedge.prize + '. Show this code in-store or use it at checkout.';
        codeWrap.style.display = '';
        codeEl.textContent = wedge.code;
      };
      rot.addEventListener('transitionend', onEnd);
      setTimeout(onEnd, 5200); // fallback
    });

    const copyBtn = document.getElementById('spin-copy');
    if (copyBtn) copyBtn.addEventListener('click', function () {
      navigator.clipboard && navigator.clipboard.writeText(codeEl.textContent || '');
      copyBtn.textContent = 'COPIED';
      setTimeout(function () { copyBtn.textContent = 'COPY'; }, 1500);
    });
  })();
</script>

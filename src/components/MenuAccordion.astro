---
interface MenuItem {
  name: string;
  price: string;
  description: string;
}
interface Category {
  name: string;
  items: MenuItem[];
}

interface Props {
  categories: Category[];
  exclusive?: boolean;
}
const { categories, exclusive = false } = Astro.props;
---

<div class="mt-10">
  {categories.map((cat, i) => (
    <details class:list={['border border-gold rounded-none bg-transparent group', i > 0 && '-mt-px']} open={i === 0} name={exclusive ? 'home-menu' : undefined}>
      <summary class="cursor-pointer list-none bg-brown px-5 py-4 flex items-center gap-3">
        <svg
          viewBox="0 0 24 24"
          class="w-7 h-7 text-gold shrink-0 transition-transform duration-500 group-open:rotate-180"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M6 15l6-6 6 6" />
        </svg>
        <span class="text-gold text-[30px] font-body leading-none">{cat.name}</span>
      </summary>
      <div class="grid md:grid-cols-2 gap-x-8 gap-y-4 p-5">
        {cat.items.map((item) => (
          <div class="flex gap-3 items-start">
            <img src="/images/theme/menu-icon.png" alt="" width="46" height="46" class="shrink-0" />
            <div class="flex-1">
              <h5 class="relative text-tan text-[18px] font-body md:after:content-[''] md:after:absolute md:after:left-0 md:after:-bottom-1 md:after:w-full md:after:h-0.5 md:after:bg-tan">
                {item.name}
                <span class="float-right">{item.price}</span>
              </h5>
              <p class="font-article italic text-muted-blue text-[15px] mt-2">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </details>
  ))}
</div>

<style>
  /* Smooth open/close: animate the content height + fade.
     Progressive enhancement — browsers without ::details-content support just snap. */
  details {
    overflow: hidden;
  }
  details::details-content {
    block-size: 0;
    opacity: 0;
    transition:
      block-size 0.35s ease,
      opacity 0.35s ease,
      content-visibility 0.35s allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
    opacity: 1;
  }
</style>

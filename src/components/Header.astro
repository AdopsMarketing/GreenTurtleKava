---
import Container from './Container.astro';
import SocialIcons from './icons/SocialIcons.astro';

// Structure verified against the live site's rendered header HTML (desktop: two flanking
// nav lists around the logo; mobile: separate 7-item collapse menu). No dropdowns exist
// anywhere in the source nav — it is intentionally flat.
const leftNav = [
  { label: 'HOME', href: '/' },
  { label: 'WHO WE ARE', href: '/about-us/' },
  { label: 'MENU', href: '/menu/' },
];
const rightNav = [
  { label: 'EVENTS', href: '/events/' },
  { label: 'WHAT IS KAVA?', href: '/what-is-kava/' },
  { label: 'CONTACT US', href: '/contact-us/' },
];
// Mobile menu includes two extra items (Locations, Blog) that desktop omits, matching source.
const mobileNav = [
  { label: 'HOME', href: '/' },
  { label: 'WHO WE ARE', href: '/about-us/' },
  { label: 'MENU', href: '/menu/' },
  { label: 'LOCATIONS', href: '/locations/' },
  { label: 'WHAT IS KAVA', href: '/what-is-kava/' },
  { label: 'BLOG', href: '/blog/' },
  { label: 'CONTACT US', href: '/contact-us/' },
];

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---

<header id="site-header">
  <div class="bg-navy text-white h-[41px] flex items-center">
    <Container class="flex items-center justify-between">
      <button aria-label="Search" class="text-gold">
        <SocialIcons name="search" class="w-4 h-4" />
      </button>
      <div class="flex items-center gap-4 text-[17px] font-nav">
        <span class="hidden sm:inline">CONNECT</span>
        <a href="https://www.facebook.com/greenturtlekavabar" class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gold text-navy border border-gold transition-colors duration-300 hover:bg-transparent hover:text-gold" aria-label="Facebook">
          <SocialIcons name="facebook" class="w-3.5 h-3.5" />
        </a>
        <a href="https://www.instagram.com/greenturtlekavabar" class="text-gold" aria-label="Instagram">
          <SocialIcons name="instagram" class="w-4 h-4" />
        </a>
        <a href="#" class="text-gold" aria-label="TikTok">
          <SocialIcons name="tiktok" class="w-4 h-4" />
        </a>
        <a href="tel:9046949052" class="transition-colors duration-300 hover:text-link-hover">9046949052</a>
        <a href="/shop/" class="hidden sm:inline transition-colors duration-300 hover:text-gold">SHOP</a>
        <a href="/cart/" class="relative inline-flex items-center text-gold transition-colors duration-300 hover:text-white" aria-label="Cart">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor" aria-hidden="true">
            <path d="M7 4h-2l-1 2H2v2h2l3.6 7.59-1.35 2.44A2 2 0 0 0 8 21h11v-2H8.42a.25.25 0 0 1-.22-.37l.94-1.63h6.45a2 2 0 0 0 1.8-1.11l3.58-7.16A1 1 0 0 0 20 7H6.21l-.94-2H7zM8 22a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m9 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3"/>
          </svg>
          <span data-cart-count class="hidden absolute -top-2 -right-2 min-w-[16px] h-4 px-1 rounded-full bg-alert-red text-white text-[11px] font-nav-book leading-4 text-center">0</span>
        </a>
      </div>
    </Container>
  </div>

  <div class="relative bg-gold">
    <Container class="grid grid-cols-3 items-center py-2 lg:py-0 lg:h-[145px]">
      <nav class="hidden lg:flex justify-start">
        <ul class="flex gap-6 font-nav text-[16px]">
          {leftNav.map((item) => (
            <li>
              <a href={item.href} class:list={['text-white hover:text-brown-dark transition-colors duration-300', isActive(item.href) && '!text-brown-dark']}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex justify-center">
        <a href="/" class="block relative lg:-mb-16">
          <img src="/images/logo.png" alt="Green Turtle Kava logo" width="141" height="131" class="w-[110px] lg:w-[141px] h-auto" />
        </a>
      </div>

      <div class="flex justify-end items-center">
        <nav class="hidden lg:flex">
          <ul class="flex gap-6 font-nav text-[16px]">
            {rightNav.map((item) => (
              <li>
                <a href={item.href} class:list={['text-white hover:text-brown-dark transition-colors duration-300', isActive(item.href) && '!text-brown-dark']}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <button
          id="mobile-menu-toggle"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle navigation"
          class="lg:hidden flex flex-col justify-center items-center gap-1.5 w-11 h-11"
        >
          <span class="block h-0.5 w-6 bg-body-text"></span>
          <span class="block h-0.5 w-6 bg-body-text"></span>
          <span class="block h-0.5 w-6 bg-body-text"></span>
        </button>
      </div>
    </Container>

    <nav id="mobile-menu" class="lg:hidden hidden bg-gold border-t border-brown/20">
      <ul class="flex flex-col font-nav text-[17px]">
        {mobileNav.map((item) => (
          <li class="border-b border-brown/10 last:border-b-0">
            <a href={item.href} class:list={['block px-4 py-3 text-white hover:text-brown-dark transition-colors duration-300', isActive(item.href) && '!text-brown-dark']}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
</script>

<script>
  import { cartCount } from '../scripts/cart';
  const badge = document.querySelector<HTMLElement>('[data-cart-count]');
  function refresh() {
    if (!badge) return;
    const n = cartCount();
    badge.textContent = String(n);
    badge.classList.toggle('hidden', n === 0);
  }
  refresh();
  window.addEventListener('cart:updated', refresh);
  // Reflect changes made in other tabs.
  window.addEventListener('storage', (e) => {
    if (e.key === 'gtk_cart') refresh();
  });
</script>

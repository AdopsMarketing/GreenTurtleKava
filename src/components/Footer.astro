---
import { getCollection } from 'astro:content';
import Container from './Container.astro';

const locations = await getCollection('locations');
// Display order matches the live site's footer card order (St. Augustine, Daytona Beach, Ormond Beach)
const order = ['kava-bar-at-st-augustine', 'kava-bar-at-daytona-beach', 'kava-bar-at-ormond-beach'];
const sorted = order.map((slug) => locations.find((l) => l.data.slug === slug)!).filter(Boolean);

const footerNav = [
  { label: 'JOBS', href: '/jobs/' },
  { label: 'EVENTS', href: '/events/' },
  { label: 'TURTLE TRIBE', href: '/turtle-tribe/' },
  { label: 'PRIVACY POLICY', href: '/privacy-policy/' },
  { label: 'CONTACT US', href: '/contact-us/' },
  { label: 'LOCATIONS', href: '/locations/' },
  { label: 'BLOG', href: '/blog/' },
];

const year = new Date().getFullYear();
---

<footer class="bg-brown text-white">
  <Container class="pt-6 pb-10">
    <div class="text-center -mt-10 mb-4">
      <button
        id="back-to-top"
        aria-label="Back to top"
        title="Top"
        class="inline-flex flex-col items-center justify-center w-[58px] h-[58px] rounded-full bg-white text-brown text-[16px] font-nav shadow-md"
      >
        <svg viewBox="0 0 24 24" class="w-3 h-3" fill="currentColor" aria-hidden="true"><path d="M12 5l7 7-1.4 1.4L13 8.8V19h-2V8.8l-4.6 4.6L5 12z"/></svg>
        TOP
      </button>
    </div>

    <nav class="mt-8">
      <ul class="flex flex-wrap justify-center gap-x-2 gap-y-2 font-nav text-[18px]">
        {footerNav.map((item) => (
          <li>
            <a href={item.href} class="inline-block px-3 py-1.5 text-white">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-10 grid grid-cols-1 lg:grid-cols-3 gap-8 text-center font-nav">
      <div>
        <img src="/images/theme/pin.png" alt="" class="mx-auto max-w-[50px]" width="50" height="50" />
        <h4 class="text-[23px] pt-4">Addresses</h4>
        {sorted.map((loc) => (
          <p class="text-[18px] mt-2">{loc!.data.address}</p>
        ))}
      </div>
      <div class="lg:border-x-2 lg:border-gold">
        <img src="/images/theme/ph.png" alt="" class="mx-auto max-w-[50px]" width="50" height="50" />
        <h4 class="text-[23px] pt-4">Phone</h4>
        {sorted.map((loc) => (
          <p class="text-[18px] mt-2">
            {loc!.data.shortName}: <a href={`tel:${loc!.data.phone}`} class="text-white">{loc!.data.phone}</a>
          </p>
        ))}
      </div>
      <div>
        <img src="/images/theme/clo.png" alt="" class="mx-auto max-w-[50px]" width="50" height="50" />
        <h4 class="text-[23px] pt-4">Hours</h4>
        {sorted.map((loc) => (
          <p class="text-[18px] mt-2">
            <a href={`/${loc!.data.slug}/`} class="text-white">GTK at {loc!.data.shortName}</a>
          </p>
        ))}
      </div>
    </div>
  </Container>

  <div class="border-t-2 border-gold mt-[50px] py-5">
    <Container>
      <p class="text-center text-[19px]">&copy; GREEN TURTLE KAVA BAR, {year}. All Rights Reserved.</p>
    </Container>
  </div>
</footer>

<script>
  document.getElementById('back-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
